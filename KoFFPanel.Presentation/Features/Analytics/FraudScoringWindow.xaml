<ui:FluentWindow x:Class="KoFFPanel.Presentation.Features.Analytics.FraudScoringWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Title}"
                 Height="600"
                 Width="950"
                 WindowStartupLocation="CenterOwner"
                 Background="#0a0a0a"
                 ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KoFFPanel.Presentation;component/Styles/CabinetWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="#1affffff">
            <StackPanel>
                <Border Height="3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">
                            <GradientStop Color="#00f2ff"
                                          Offset="0" />
                            <GradientStop Color="#ff00aa"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <ui:TitleBar Title="{Binding Title}"
                             Background="Transparent"
                             Foreground="White"
                             Padding="15,10" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#1c1e27"
                CornerRadius="12"
                Padding="15"
                Margin="20">
            <DataGrid ItemsSource="{Binding BehaviorLogs}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      RowBackground="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      IsReadOnly="True"
                      Foreground="White"
                      CanUserResizeColumns="True"
                      HorizontalScrollBarVisibility="Hidden"
                      ColumnHeaderStyle="{StaticResource StandardDataGridHeader}"
                      CellStyle="{StaticResource StandardDataGridCell}"
                      RowStyle="{StaticResource StandardDataGridRow}">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Transparent" />
                    <Style TargetType="ScrollBar">
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="0" />
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ДАТА"
                                        Binding="{Binding DateStr}"
                                        Foreground="#b3ffffff"
                                        Width="120" />
                    <DataGridTextColumn Header="МАКС. СЕССИЙ"
                                        Binding="{Binding MaxSessions}"
                                        FontWeight="Bold"
                                        Width="120" />
                    <DataGridTextColumn Header="КОЛ-ВО ПРОВАЙДЕРОВ (ASN)"
                                        Binding="{Binding AsnCount}"
                                        Width="200" />
                    <DataGridTextColumn Header="GEO ПРЫЖКИ"
                                        Binding="{Binding GeoJumps}"
                                        Width="120" />
                    <DataGridTextColumn Header="АНОМАЛИИ ТРАФИКА"
                                        Binding="{Binding TrafficSpike}"
                                        Width="150" />
                    <DataGridTemplateColumn Header="РИСК-ФАКТОР"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="5">
                                    <TextBlock Text="{Binding RiskScore, StringFormat={}{0}%}"
                                               Foreground="{Binding RiskColor}"
                                               FontWeight="Bold"
                                               Width="40"
                                               VerticalAlignment="Center" />
                                    <Border Background="#1affffff"
                                            Height="6"
                                            Width="100"
                                            CornerRadius="3"
                                            VerticalAlignment="Center"
                                            Margin="10,0">
                                        <Border HorizontalAlignment="Left"
                                                Width="{Binding RiskScore}"
                                                CornerRadius="3"
                                                Background="{Binding RiskColor}" />
                                    </Border>
                                    <TextBlock Text="{Binding RiskText}"
                                               Foreground="{Binding RiskColor}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</ui:FluentWindow>